<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.magnifier.MagnifierFragment">

    <TextView
        android:id="@+id/text_magnifier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:textAlignment="center"
        android:textSize="20sp"
        android:text="Take a photo to magnify your picture"
        />

    <Button
        android:id="@+id/btncamera_id"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_below="@id/text_magnifier"
        android:text="Start Camera"
        tools:ignore="VisualLintButtonSize" />

    <ImageView
        android:id="@+id/imageview_camera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btncamera_id"
        />

</RelativeLayout>